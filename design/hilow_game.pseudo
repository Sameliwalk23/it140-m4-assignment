START hilow_game

OUTPUT "Welcome to the Higher/Lower Game!"
OUTPUT "Enter the lower bound:"
INPUT lowerBound

OUTPUT "Enter the upper bound:"
INPUT upperBound

WHILE lowerBound >= upperBound
    OUTPUT "Invalid input. Lower bound must be less than upper bound."
    OUTPUT "Enter the lower bound:"
    INPUT lowerBound
    OUTPUT "Enter the upper bound:"
    INPUT upperBound
END WHILE

SET randomNumber = random number between lowerBound and upperBound

OUTPUT "Guess a number between " + lowerBound + " and " + upperBound
INPUT guess

WHILE guess < lowerBound OR guess > upperBound
    OUTPUT "Invalid guess. Enter a number within the range."
    INPUT guess
END WHILE

WHILE guess <> randomNumber
    IF guess < randomNumber THEN
       OUTPUT "Too low! Try again."
    ELSE
        OUTPUT "Too high! Try again."
    END IF

    OUTPUT "Guess a number between " + lowerBound + " and " + upperBound
    INPUT guess

    WHILE guess < lowerBound OR guess > upperBound
        OUTPUT "Invalid guess. Enter a number within the range."
        INPUT guess
    END WHILE
END WHILE

OUTPUT "Congratulations! You guessed the correct number!"

END hilow_game
